rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function passwordOk() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().mustChangePassword != true;
    }
    function isTeacher() {
      return passwordOk() && myUser().role == "teacher";
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isTeacher();
      allow create, delete: if false;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["mustChangePassword", "updatedAt"])
        && request.resource.data.mustChangePassword == false
        && resource.data.mustChangePassword == true;
      allow update: if isSelf(uid) && passwordOk()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["hoTen", "sdt", "gmail", "lop", "updatedAt"]);
    }

    match /weeks/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /lessons/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }

    match /practiceFolders/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /practiceItems/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }

    match /materialFolders/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /materialItems/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }

    match /materials/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /submissions/{id} {
      allow read: if passwordOk() && (
        isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create: if passwordOk()
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isTeacher()
        || (passwordOk() && resource.data.studentId == request.auth.uid);
    }
    match /classes/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /grades/{id} {
      allow read: if passwordOk() && (
        isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow write: if isTeacher();
    }
    match /teacherNotes/{uid} {
      allow read, write: if isTeacher() && request.auth.uid == uid;
    }
    match /studentNotes/{uid} { allow read, write: if passwordOk() && request.auth.uid == uid; }
    match /calendarNotes/{uid} { allow read, write: if passwordOk() && request.auth.uid == uid; }
    match /sharedCalendarNotes/{id} {
      allow read: if passwordOk();
      allow create, update: if isTeacher();
    }
    match /schoolSettings/{id} {
      allow read: if passwordOk();
      allow write: if isTeacher();
    }
    match /assignmentProgress/{id} {
      allow read: if isTeacher() || (passwordOk() && resource.data.studentId == request.auth.uid);
      allow create, update: if passwordOk() && request.resource.data.studentId == request.auth.uid;
      allow delete: if passwordOk() && resource.data.studentId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
